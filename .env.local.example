# NextAuth
NEXTAUTH_SECRET=replace-with-a-random-string
NEXTAUTH_URL=http://localhost:3000

# Hygraph (required) — both TODOs and user accounts are stored in
# Hygraph's GraphQL Content API. See lib/hygraph.ts (ToDo model) and
# lib/hygraphUsers.ts (AppUser model) for the expected content models,
# and README.md for setup steps.
HYGRAPH_ENDPOINT=https://api-<region>.hygraph.com/v2/<project-id>/master
HYGRAPH_TOKEN=your-permanent-auth-token
